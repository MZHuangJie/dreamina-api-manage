# 复制成 .env 后填写。这个文件不要提交到版本库。
#
#   cp .env.example .env && vi .env

# 你的域名（必须已经解析到这台服务器的公网 IP，Caddy 才能签发证书）
DOMAIN=api.example.com

# 管理端访问令牌。容器里管理端只绑回环，一般不直接对外；
# 但如果你要 SSH 隧道进来用界面，这个令牌就是那道锁。
# 生成方式：openssl rand -hex 24
MANAGER_ACCESS_TOKEN=

# 一次生成最多尝试几个账号（失败会自动换号）
MANAGER_MAX_ATTEMPTS=3

# 同时进行中的生成上限。调大之前先看内存和账号数：
# 每个进行中的生成会占用浏览器通道里的一个页面上下文。
MANAGER_MAX_CONCURRENT=4

# 并发满时排队等待的上限（毫秒），排不上就返回 503
MANAGER_QUEUE_WAIT_MS=30000

# 网关同步等待出图的上限（毫秒）。超过就让调用方用返回的 task_id 继续查
GATEWAY_WAIT_TIMEOUT_MS=180000

# 失败账号的冷却时长（毫秒）
MANAGER_FAILURE_COOLDOWN_MS=60000

# 保活巡检间隔（毫秒），默认 30 分钟
MANAGER_HEALTH_INTERVAL_MS=1800000
